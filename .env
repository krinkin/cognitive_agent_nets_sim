# Environment variables for Docker configuration
# Used by docker-compose and scripts to maintain consistent settings

# Docker image name
DOCKER_IMAGE=can_poc

# Directory mapping for volumes
HOST_CODE_DIR=.
CONTAINER_CODE_DIR=/app

# Results directory
HOST_RESULTS_DIR=./results
CONTAINER_RESULTS_DIR=/app/logs

# Docker run default settings
DOCKER_RUN_OPTS="--rm -v ${HOST_CODE_DIR}:${CONTAINER_CODE_DIR} -e LOGDIR=${CONTAINER_RESULTS_DIR}"